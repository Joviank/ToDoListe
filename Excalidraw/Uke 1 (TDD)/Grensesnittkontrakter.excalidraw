      "boundElements": null,
      "updated": 1785396868120,
      "link": null,
      "locked": false,
      "text": "Frontend bryr seg kun om:\n- GET /Tasks\n- POST /Tasks\n- DELETE /Tasks/{id}\n\nFrontend bryr seg kun om\nresultatet den får sendt tilbake\netter et kall.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frontend bryr seg kun om:\n- GET /Tasks\n- POST /Tasks\n- DELETE /Tasks/{id}\n\nFrontend bryr seg kun om\nresultatet den får sendt tilbake\netter et kall.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "G4W6RLHnwEhvKU8cyFEvZ",
      "type": "text",
      "x": 749.6954210409817,
      "y": 750.0915059360574,
      "width": 353.6197509765625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
