    {
      "id": "G3fGV0oTVcgjbkmPL1OKS",
      "type": "text",
      "x": 332.4179382324219,
      "y": 246.91790771484375,
      "width": 660.8595581054688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA3",
      "roundness": null,
      "seed": 738477218,
      "version": 173,
      "versionNonce": 1615687358,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785395282761,
      "link": null,
      "locked": false,
      "text": "Hvis vi endrer backend f.eks. NivåSystemet, To-do liste etc. internt.\nBurde frontend slutte å virke?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hvis vi endrer backend f.eks. NivåSystemet, To-do liste etc. internt.\nBurde frontend slutte å virke?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XykbN0zqHZGGMSG1FJEMa",
      "type": "text",
      "x": 344.8516540527344,
      "y": 332.12687691645834,
      "width": 665.7595825195312,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA4",
      "roundness": null,
      "seed": 1587223714,
      "version": 246,
      "versionNonce": 611116798,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785395282761,
      "link": null,
      "locked": false,
      "text": "Dersom en feil oppstår i backend skal dette IKKE påvirke frontend, \nda frontend snakker kun med APIet og har ALDRI direkte tilgang\ntil backend.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dersom en feil oppstår i backend skal dette IKKE påvirke frontend, \nda frontend snakker kun med APIet og har ALDRI direkte tilgang\ntil backend.",
      "autoResize": true,
      "lineHeight": 1.25
