      "isDeleted": false,
      "boundElements": [],
      "updated": 1785396868120,
      "link": null,
      "locked": false,
      "text": "Frontend bryr seg ikke om \nhvordan backend fungerer internt:\n\n- Hvordan tasks lagres\n- Hvilken database som blir benyttet\n- Hvilken klasser backend bruker",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
