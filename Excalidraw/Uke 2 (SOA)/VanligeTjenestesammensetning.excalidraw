      "isDeleted": false,
      "boundElements": null,
      "updated": 1786001016341,
      "link": null,
      "locked": false,
      "text": "TLDR: Ingress forteller hvor trafikken skal gå.\nReverse proxyen sørger for at den faktisk kommer dit.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TLDR: Ingress forteller hvor trafikken skal gå.\nReverse proxyen sørger for at den faktisk kommer dit.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
