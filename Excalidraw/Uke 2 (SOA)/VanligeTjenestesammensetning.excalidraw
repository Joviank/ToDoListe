    {
      "id": "n4xFall_mzseU5CMBdVXW",
      "type": "text",
      "x": 765.7456625316881,
      "y": 961.3141524822906,
      "width": 513.0596923828125,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ae",
      "roundness": null,
      "seed": 1815636086,
      "version": 406,
      "versionNonce": 2016705386,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786001016341,
      "link": null,
      "locked": false,
      "text": "Proxy = En mellommann som videresender trafikk\n\nReverse proxy = Mottar forespørsler fra brukere og \nsender dem til riktig backend-tjeneste\n\nIngress = Kubernetes-regler som beskriver hvordan\ninnkommende trafikk skal rutes\n\nIngress controller = programmet (f.eks. NGINX) som \nleser ingress-reglene og fungerer\nsom reverse proxy.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proxy = En mellommann som videresender trafikk\n\nReverse proxy = Mottar forespørsler fra brukere og \nsender dem til riktig backend-tjeneste\n\nIngress = Kubernetes-regler som beskriver hvordan\ninnkommende trafikk skal rutes\n\nIngress controller = programmet (f.eks. NGINX) som \nleser ingress-reglene og fungerer\nsom reverse proxy.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iAXuIYIUCbMdWKZY41_7L",
